{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "pipeline": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": { "cache": true },
    "test": { "cache": true, "dependsOn": ["^build"] },
    "typecheck": { "cache": true },
    "clean": { "cache": false }
  }
}
