{
  "name": "@app/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo.js",
  "scripts": {
    "dev": "cross-env CHOKIDAR_USEPOLLING=1 expo start --clear --offline",
    "start": "cross-env CHOKIDAR_USEPOLLING=1 expo start --clear --offline",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "cross-env CHOKIDAR_USEPOLLING=1 EXPO_OFFLINE=1 expo start --web --clear",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf node_modules dist .expo"
  },
  "dependencies": {
    "@app/shared": "file:../../packages/shared",
    "@app/ui": "file:../../packages/ui",
    "@react-navigation/bottom-tabs": "^7.4.10",
    "@react-navigation/native": "^7.1.10",
    "@react-navigation/native-stack": "^7.3.10",
    "expo": "~54.0.0",
    "expo-status-bar": "~2.0.0",
    "react": "19.1.0",
    "react-dom": "^19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.20.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/react": "~19.1.10",
    "@types/react-dom": "~19.1.10",
    "typescript": "~5.8.2"
  }
}
